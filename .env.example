# Login for the web app (HTTP basic auth). Required if the app is reachable from the internet.
APP_USER=golf
APP_PASSWORD=change-me
# Largest upload accepted, in MB. 240fps clips are ~40 MB per second of 1080p video.
MAX_UPLOAD_MB=600
# 1 keeps the uploaded video so swings can be re-analyzed after an update (0 deletes it after analysis).
KEEP_ORIGINALS=1
# 127.0.0.1 = only reachable through a reverse proxy; 0.0.0.0 = reachable at http://SERVER_IP:8077
BIND=127.0.0.1
# Optional iCloud Photos album import (see docker-compose.yml): uncomment to turn it on.
# COMPOSE_PROFILES=icloud
# ICLOUD_USER=you@example.com
# ICLOUD_ALBUM=Golf
# ICLOUD_SIGNIN_URL=https://icloud.example.com
